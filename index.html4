<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESP32 GitHub Remote Controller</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0d1117;
            color: #c9d1d9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .card {
            background-color: #161b22;
            border: 1px solid #30363d;
            width: 100%;
            max-width: 380px;
            padding: 28px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        h2 {
            font-size: 20px;
            color: #58a6ff;
            margin-bottom: 6px;
        }

        p.sub {
            font-size: 12px;
            color: #8b949e;
            margin-bottom: 20px;
        }

        .ip-config {
            margin-bottom: 20px;
            text-align: left;
        }

        .ip-config label {
            font-size: 12px;
            color: #8b949e;
            display: block;
            margin-bottom: 6px;
        }

        .ip-config input {
            width: 100%;
            padding: 10px;
            background-color: #0d1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #58a6ff;
            font-size: 14px;
            text-align: center;
            outline: none;
        }

        .status-box {
            background-color: #21262d;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 14px;
            margin-bottom: 20px;
        }

        .status-title {
            font-size: 11px;
            color: #8b949e;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-value {
            font-size: 20px;
            font-weight: bold;
            margin-top: 4px;
            color: #f85149;
        }

        .btn-group {
            display: flex;
            gap: 12px;
        }

        button {
            flex: 1;
            padding: 12px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        button:hover {
            opacity: 0.9;
        }

        .btn-on {
            background-color: #238636;
            color: #ffffff;
        }

        .btn-off {
            background-color: #da3633;
            color: #ffffff;
        }

        .footer {
            margin-top: 20px;
            font-size: 11px;
            color: #484f58;
            border-top: 1px solid #21262d;
            padding-top: 14px;
        }
    </style>
</head>
<body>

    <div class="card">
        <h2>ESP32 Remote Controller</h2>
        <p class="sub">Hosted on GitHub Pages</p>

        <div class="ip-config">
            <label for="ipInput">Masukkan IP ESP32 (Lokal):</label>
            <input type="text" id="ipInput" placeholder="Contoh: 192.168.1.50" value="192.168.1.50">
        </div>

        <div class="status-box">
            <div class="status-title">Status Lampu LED</div>
            <div id="statusText" class="status-value">MEMUAT...</div>
        </div>

        <div class="btn-group">
            <button class="btn-on" onclick="sendControl('on')">NYALAKAN</button>
            <button class="btn-off" onclick="sendControl('off')">MATIKAN</button>
        </div>

        <div class="footer">
            Pin D2 (LED) | Pin 32 (ON) | Pin 35 (OFF)
        </div>
    </div>

    <script>
        function getIp() {
            return document.getElementById('ipInput').value.trim();
        }

        function sendControl(action) {
            const ip = getIp();
            if (!ip) {
                alert("Masukkan IP ESP32 terlebih dahulu!");
                return;
            }

            fetch(`http://${ip}/api/led/${action}`)
                .then(response => response.json())
                .then(data => {
                    updateStatusUI(data.status);
                })
                .catch(err => {
                    console.error("Gagal terhubung:", err);
                    document.getElementById('statusText').innerText = "TERPUTUS";
                    document.getElementById('statusText').style.color = "#8b949e";
                });
        }

        function checkStatus() {
            const ip = getIp();
            if (!ip) return;

            fetch(`http://${ip}/api/status`)
                .then(response => response.json())
                .then(data => {
                    updateStatusUI(data.status);
                })
                .catch(() => {
                    document.getElementById('statusText').innerText = "TERPUTUS";
                    document.getElementById('statusText').style.color = "#8b949e";
                });
        }

        function updateStatusUI(status) {
            const statusElem = document.getElementById('statusText');
            if (status === 'ON') {
                statusElem.innerText = 'NYALA (ON)';
                statusElem.style.color = '#3fb950';
            } else if (status === 'OFF') {
                statusElem.innerText = 'MATI (OFF)';
                statusElem.style.color = '#f85149';
            }
        }

        // Cek status secara periodik setiap 2 detik (agar sinkron saat tombol fisik ditekan)
        setInterval(checkStatus, 2000);
    </script>
</body>
</html>
